# ─── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.clinicevo.co.uk

# ─── Contact ─────────────────────────────────────────────────────────────────
# TODO: Add WhatsApp number in international format without + or spaces e.g. 447700900000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# TODO: Add UK phone number in tel: href format e.g. +447700900000
NEXT_PUBLIC_PHONE_NUMBER=

# ─── GoHighLevel (CRM) ────────────────────────────────────────────────────────
# Server-side only — never expose with NEXT_PUBLIC_. Private Integration Token
# and Location ID from the target GHL sub-account (Settings > Business Profile).
GHL_API_KEY=
GHL_LOCATION_ID=

# ─── Analytics ───────────────────────────────────────────────────────────────
# TODO: Add GA4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=

# TODO: Add GTM container ID if using Tag Manager (format: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=
